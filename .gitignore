# Nested Next.js project generated output and dependencies
/cricgeek-app/node_modules/
/cricgeek-app/.next/
/cricgeek-app/out/
/cricgeek-app/build/
/cricgeek-app/.vercel/
/cricgeek-app/coverage/

# Local environment files and secrets
/cricgeek-app/.env
