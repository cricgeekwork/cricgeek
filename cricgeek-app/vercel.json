{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": ".",
      "framework": "nextjs"
    },
    "insights": {
      "root": "insights_service",
      "entrypoint": "main.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/_insights",
      "destination": {
        "service": "insights"
      }
    },
    {
      "source": "/_insights/(.*)",
      "destination": {
        "service": "insights"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
